# Codex execution policy for the Claude-led task lifecycle.
#
# Codex implements and validates inside its sandbox. Claude Code owns every
# Git/GitHub write through the GitHub App identity (docs/rules/git-workflow.md),
# so Codex may not mutate Git state, use the GitHub CLI, or start nested Codex
# runs. Read-only Git inspection (status, diff, log, show) remains available.

prefix_rule(
    pattern = [["git", "git.exe"], "commit"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "push"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "pull"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "fetch"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "merge"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "rebase"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "checkout"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "switch"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "restore"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "branch"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "tag"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "stash"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "clean"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "worktree"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "remote"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "config"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "cherry-pick"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "revert"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "am"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "apply"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "update-ref"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["git", "git.exe"], "gc"],
    decision = "forbidden",
    justification = "Git state changes belong to Claude Code; Codex only edits files and validates.",
)

prefix_rule(
    pattern = [["gh", "gh.exe"]],
    decision = "forbidden",
    justification = "GitHub operations use the GitHub App identity through Claude Code.",
)

prefix_rule(
    pattern = [["codex", "codex.exe"]],
    decision = "forbidden",
    justification = "Nested Codex runs are not part of the task lifecycle.",
)

prefix_rule(
    pattern = [["pwsh", "pwsh.exe", "powershell", "powershell.exe"], "-NoProfile", "-File", "scripts/github-app/github-app.ps1"],
    decision = "forbidden",
    justification = "The GitHub App helper is reserved for Claude Code.",
)
